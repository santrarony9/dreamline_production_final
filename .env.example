# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dreamline?retryWrites=true&w=majority

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_32_chars
NEXTAUTH_URL=http://localhost:3000

# Admin Access
ADMIN_USER=info.dreamline@gmail.com
ADMIN_PASS=your_admin_password
ADMIN_2FA_SECRET=your_admin_2fa_secret

# Maintenance Access
MAINT_USER=maintenance@dreamline.com
MAINT_PASS=your_maintenance_password
MAINT_2FA_SECRET=your_maint_2fa_secret

# Automation
AUTOMATION_SECRET=your_automation_secret
