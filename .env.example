# Google Business Profile Direct Integration
GBP_CLIENT_ID=your_gbp_client_id
GBP_CLIENT_SECRET=your_gbp_client_secret
GBP_REFRESH_TOKEN=your_gbp_refresh_token
GBP_ACCOUNT_ID=your_gbp_account_id
