{
    "framework": "nextjs",
    "outputDirectory": ".next",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        }
    ],
    "crons": [
        {
            "path": "/api/admin/automation/daily-sync?secret=dreamline_auto_2026",
            "schedule": "30 3 * * *"
        },
        {
            "path": "/api/admin/automation/audit?secret=dreamline_auto_2026",
            "schedule": "30 4 * * *"
        }
    ]
}